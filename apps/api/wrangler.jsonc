{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "varuna-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "VARUNA_ENV": "preview" }
}